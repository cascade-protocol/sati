# Solana keypair JSON file (e.g. ~/.config/solana/id.json)
# Generate one with: solana-keygen new
KEYPAIR_PATH=~/.config/solana/id.json

# Solana RPC URL (optional - defaults to public endpoint for NETWORK)
# RPC_URL=https://api.devnet.solana.com

# Pinata JWT for IPFS uploads (required for registration examples)
# Get one at https://www.pinata.cloud/
PINATA_JWT=

# Network: mainnet, devnet, or localnet (default: devnet)
NETWORK=devnet

# Agent ID for feedback examples (format: solana:<chainRef>:<mintAddress>)
# Run quick-start.ts first to get an agent ID
# AGENT_ID=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1:<your-mint-address>
